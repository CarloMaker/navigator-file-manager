<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>Navigator File Manager</Company>
    <Product>Navigator File Manager</Product>
    <Copyright>Copyright © 2026 Navigator File Manager contributors. MIT License.</Copyright>
    <Version>0.1.2</Version>
    <!-- WPF0001: ThemeMode (tema Fluent di Windows 11) è ancora marcato sperimentale -->
    <NoWarn>$(NoWarn);WPF0001;CA1416</NoWarn>
  </PropertyGroup>
</Project>
