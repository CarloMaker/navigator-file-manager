<Window x:Class="Navigator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Navigator.Core.Localization;assembly=Navigator.Core"
        xmlns:ctl="clr-namespace:Navigator.App"
        xmlns:models="clr-namespace:Navigator.Core.Models;assembly=Navigator.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Navigator.Presentation.ViewModels;assembly=Navigator.Presentation"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding SelectedTab.Title, StringFormat={}{0} - Navigator, FallbackValue=Navigator}"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        Background="{DynamicResource Nav.TitleBar}"
        Foreground="{DynamicResource Nav.Text}"
        FontFamily="{StaticResource Nav.UiFont}"
        Icon="/Assets/Navigator.ico"
        FontSize="12"
        UseLayoutRounding="True">

    <!-- Schede nella barra del titolo, come Esplora file di Windows 11 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="Ctrl+F4" Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding SelectedTab.GoBackCommand}" />
        <KeyBinding Gesture="Alt+Right" Command="{Binding SelectedTab.GoForwardCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding SelectedTab.GoUpCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding SelectedTab.RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding AddBookmarkCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewFolderCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyPathCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveSessionCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+6" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:FileViewMode.Details}" />
        <KeyBinding Gesture="Ctrl+Shift+4" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:FileViewMode.MediumIcons}" />
        <KeyBinding Gesture="Ctrl+Shift+3" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:FileViewMode.LargeIcons}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Viste a icone: riquadri con miniatura e nome, in un pannello che va a capo -->
        <ItemsPanelTemplate x:Key="Nav.WrapItemsPanel">
            <WrapPanel Orientation="Horizontal" Margin="4" />
        </ItemsPanelTemplate>

        <Style x:Key="Nav.FileTile" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Nav.Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.ItemHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.ItemSelected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nav.ItemSelectedBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Nav.MediumTile">
            <StackPanel Width="88" ToolTip="{Binding FullPath}" Opacity="{Binding IsHidden, Converter={StaticResource HiddenToOpacity}}">
                <Grid Width="48" Height="48" Margin="0,4,0,4" HorizontalAlignment="Center">
                    <Image RenderOptions.BitmapScalingMode="HighQuality" ctl:Thumbnail.Size="48" ctl:Thumbnail.Item="{Binding}" />
                    <ctl:GitBadge Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Status="{Binding GitStatus}" />
                </Grid>
                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Nav.LargeTile">
            <StackPanel Width="132" ToolTip="{Binding FullPath}" Opacity="{Binding IsHidden, Converter={StaticResource HiddenToOpacity}}">
                <Grid Width="112" Height="112" Margin="0,4,0,4" HorizontalAlignment="Center">
                    <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ctl:Thumbnail.Size="128" ctl:Thumbnail.Item="{Binding}" />
                    <ctl:GitBadge Width="26" Height="26" Margin="4,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Status="{Binding GitStatus}" />
                </Grid>
                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" />
            </StackPanel>
        </DataTemplate>

        <!-- Menu sullo sfondo della lista (nessun file sotto il mouse) -->
        <ContextMenu x:Key="FolderBackgroundMenu">
            <MenuItem Header="{x:Static loc:Strings.NewFolder}" InputGestureText="{x:Static loc:Strings.GestureNewFolder}" Command="{Binding NewFolderCommand}" />
            <MenuItem Header="{x:Static loc:Strings.Paste}" InputGestureText="{x:Static loc:Strings.GesturePaste}" Command="{Binding PasteCommand}" />
            <Separator />
            <MenuItem Header="{x:Static loc:Strings.Refresh}" InputGestureText="F5" Command="{Binding SelectedTab.RefreshCommand}" />
            <MenuItem Header="{x:Static loc:Strings.AddToBookmarks}" InputGestureText="{x:Static loc:Strings.GestureBookmark}" Command="{Binding AddBookmarkCommand}" />
            <MenuItem Header="{x:Static loc:Strings.CopyPath}" InputGestureText="{x:Static loc:Strings.GestureCopyPath}" Command="{Binding CopyPathCommand}" />
            <Separator />
            <MenuItem Header="{x:Static loc:Strings.Properties}" Command="{Binding PropertiesCommand}" />
        </ContextMenu>
        <!-- ===== Questo PC: unità con la barra dello spazio, come in Esplora file ===== -->
        <Style x:Key="Nav.DriveBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Nav.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border BorderThickness="1" BorderBrush="{DynamicResource Nav.DriveBarBorder}" Background="{DynamicResource Nav.DriveBarTrack}">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pulsante della barra delle unità sopra l'albero delle cartelle -->
        <Style x:Key="Nav.DriveButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Nav.Text}" />
            <Setter Property="FontFamily" Value="{StaticResource Nav.UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Margin" Value="0,0,2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="5,2,7,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.ItemSelected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nav.ItemSelectedBorder}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.ButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.ButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Nav.DriveTile" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Nav.Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="MouseDoubleClick" Handler="OnDriveDoubleClick" />
            <EventSetter Event="MouseRightButtonUp" Handler="OnDriveRightClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"
                                Margin="0,0,8,8" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.ItemHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.ItemSelected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nav.ItemSelectedBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Elenco senza ScrollViewer proprio: scorre la vista intera, e la rotellina non si blocca sulla lista -->
        <Style x:Key="Nav.DriveList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Nav.DriveTile}" />
            <Setter Property="ItemsPanel" Value="{StaticResource Nav.WrapItemsPanel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="KeyDown" Handler="OnDriveListKeyDown" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type vm:DriveItemViewModel}">
                        <Grid Width="256" ToolTip="{Binding RootPath}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Source="{Binding Converter={StaticResource Icon}, ConverterParameter=large}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Margin="0,4,0,3" Value="{Binding UsedFraction, Mode=OneWay}"
                                             Visibility="{Binding HasSpaceInfo, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource Nav.DriveBar}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Nav.DriveBarFull}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock Text="{Binding SpaceText}" FontSize="12" Foreground="{DynamicResource Nav.TextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SpaceText, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Nav.DriveGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Nav.Text}" />
            <Setter Property="Margin" Value="0,12,0,10" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ===================== Riga 0: schede e pulsanti della finestra ===================== -->
            <DockPanel x:Name="TitleRow" Grid.Row="0" Background="{DynamicResource Nav.TitleBar}" LastChildFill="True">
                <StackPanel x:Name="CaptionButtons" DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Nav.CaptionButton}" Content="&#xE921;" ToolTip="{x:Static loc:Strings.Minimize}" Click="OnMinimizeClick" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource Nav.CaptionButton}" Content="&#xE922;" ToolTip="{x:Static loc:Strings.Maximize}" Click="OnMaximizeClick" />
                    <Button Style="{StaticResource Nav.CloseCaptionButton}" Content="&#xE8BB;" ToolTip="{x:Static loc:Strings.Close}" Click="OnCloseClick" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <ListBox x:Name="TabStrip"
                             ItemsSource="{Binding Tabs}"
                             SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource Nav.TabItem}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             VerticalAlignment="Bottom"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             WindowChrome.IsHitTestVisibleInChrome="True"
                             PreviewMouseDown="OnTabStripMouseDown"
                             PreviewMouseMove="OnTabStripMouseMove"
                             DragOver="OnTabStripDragOver"
                             Drop="OnTabStripDrop">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctl:TabStripPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                                <Grid ToolTip="{Binding CurrentPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Source="{Binding CurrentPath, Converter={StaticResource Icon}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Style="{StaticResource Nav.IconButton}" Width="26" Height="26" FontSize="10" Margin="8,0,0,0"
                                            Content="&#xE711;" ToolTip="{x:Static loc:Strings.CloseTabTip}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="NewTabButton" Style="{StaticResource Nav.IconButton}" Margin="4,8,0,0" Width="32" Height="30" FontSize="12"
                            Content="&#xE710;" ToolTip="{x:Static loc:Strings.NewTabTip}" Command="{Binding NewTabCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </DockPanel>

            <!-- ===================== Riga 1: pannelli e lista file ===================== -->
            <Grid Grid.Row="1" Background="{DynamicResource Nav.Content}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RightColumn" Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Lati della finestra: i pannelli vengono inseriti dal code-behind secondo Layout (PanelLayoutViewModel) -->
                <Grid x:Name="LeftDock" Grid.Column="0" Tag="Left" Background="{DynamicResource Nav.NavPane}" AllowDrop="True"
                      PreviewDragOver="OnDockPreviewDragOver" PreviewDragLeave="OnDockPreviewDragLeave" PreviewDrop="OnDockPreviewDrop" />

                <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
                <Rectangle x:Name="LeftDivider" Grid.Column="1" Width="1" HorizontalAlignment="Center" Fill="{DynamicResource Nav.Divider}" IsHitTestVisible="False" />

                <!-- ===== Lista file, con sotto la zona di aggancio inferiore ===== -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="BottomRow" Height="0" />
                    </Grid.RowDefinitions>

                <!-- Colonna centrale: indirizzo e ricerca, barra degli strumenti, lista -->
                <DockPanel Grid.Row="0">
                <!-- Barra indirizzi e ricerca, in cima alla colonna centrale (sopra la barra degli strumenti) -->
                <Grid DockPanel.Dock="Top" Height="48" Background="{DynamicResource Nav.Toolbar}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" MinWidth="140" MaxWidth="280" />
                    </Grid.ColumnDefinitions>


                    <!-- Barra indirizzi: breadcrumb, oppure testo modificabile (clic sullo spazio vuoto o Ctrl+L) -->
                    <Border Grid.Column="1" Style="{StaticResource Nav.InputBox}" Margin="8,0,8,0">
                        <Grid>
                            <DockPanel Visibility="{Binding IsEditingAddress, Converter={StaticResource InverseBoolToVisibility}}" LastChildFill="True">
                                <Image DockPanel.Dock="Left" Width="16" Height="16" Margin="10,0,2,0"
                                       Source="{Binding SelectedTab.CurrentPath, Converter={StaticResource Icon}}" />
                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding SelectedTab.Breadcrumbs}" VerticalAlignment="Center" ClipToBounds="True">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Nav.IconFont}" FontSize="8"
                                                           Foreground="{DynamicResource Nav.TextSecondary}" VerticalAlignment="Center" Margin="4,1,2,0" />
                                                <Button Style="{StaticResource Nav.BreadcrumbButton}" Content="{Binding Name}" ToolTip="{Binding FullPath}"
                                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding FullPath}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="Transparent" Cursor="IBeam" MouseLeftButtonDown="OnAddressBlankClick" />
                            </DockPanel>

                            <TextBox x:Name="AddressBox" Style="{StaticResource Nav.Input}" Margin="10,0"
                                     Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsEditingAddress, Converter={StaticResource BoolToVisibility}}"
                                     LostKeyboardFocus="OnAddressLostFocus">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CommitAddressCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelEditAddressCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Ricerca nella cartella corrente e sottocartelle -->
                    <Border Grid.Column="2" Style="{StaticResource Nav.InputBox}" Margin="0,0,12,0">
                        <Grid>
                            <TextBox x:Name="SearchBox" Style="{StaticResource Nav.Input}" Margin="10,0,32,0"
                                     Text="{Binding SelectedTab.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SelectedTab.SearchCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding SelectedTab.ClearSearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Margin="11,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Nav.TextSecondary}"
                                       Text="{Binding SelectedTab.Title, Converter={StaticResource StringFormat}, ConverterParameter={x:Static loc:Strings.SearchIn}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button HorizontalAlignment="Right" Style="{StaticResource Nav.IconButton}" Width="30" Height="28" FontSize="14"
                                    Content="&#xE721;" ToolTip="{x:Static loc:Strings.SearchTip}" Command="{Binding SelectedTab.SearchCommand}" />
                        </Grid>
                    </Border>
                </Grid>
                <!-- Barra degli strumenti della lista: navigazione e comandi, come in CubicExplorer.
                     Se la colonna è stretta i pulsanti vanno a capo. -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Nav.Toolbar}" BorderBrush="{DynamicResource Nav.Divider}" BorderThickness="0,0,0,1"
                        MinHeight="44" Padding="8,4">
                    <WrapPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource Nav.IconButton}" Content="&#xE72B;" ToolTip="{x:Static loc:Strings.BackTip}" Command="{Binding SelectedTab.GoBackCommand}" />
                            <Button Style="{StaticResource Nav.IconButton}" Content="&#xE72A;" ToolTip="{x:Static loc:Strings.ForwardTip}" Command="{Binding SelectedTab.GoForwardCommand}" />
                            <Button Style="{StaticResource Nav.IconButton}" Content="&#xE74A;" ToolTip="{x:Static loc:Strings.UpTip}" Command="{Binding SelectedTab.GoUpCommand}" />
                            <Button Style="{StaticResource Nav.IconButton}" Content="&#xE72C;" ToolTip="{x:Static loc:Strings.RefreshTip}" Command="{Binding SelectedTab.RefreshCommand}" />
                            <Rectangle Width="1" Height="24" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Nav.Divider}" />
                            <Button Style="{StaticResource Nav.CommandButton}" Command="{Binding NewFolderCommand}" ToolTip="{x:Static loc:Strings.NewFolderTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Nav.Glyph}" Text="&#xE8F4;" />
                                    <TextBlock Text="{x:Static loc:Strings.NewFolder}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Rectangle Width="1" Height="24" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Nav.Divider}" />
                            <Button Style="{StaticResource Nav.IconButton}" Content="&#xE8C6;" ToolTip="{x:Static loc:Strings.CutTip}" Command="{Binding CutCommand}" />
                            <Button Style="{StaticResource Nav.IconButton}" Content="&#xE8C8;" ToolTip="{x:Static loc:Strings.CopyTip}" Command="{Binding CopyCommand}" />
                            <Button Style="{StaticResource Nav.IconButton}" Content="&#xE77F;" ToolTip="{x:Static loc:Strings.PasteTip}" Command="{Binding PasteCommand}" />
                            <Button Style="{StaticResource Nav.IconButton}" Content="&#xE8AC;" ToolTip="{x:Static loc:Strings.RenameTip}" Command="{Binding RenameCommand}" />
                            <Button Style="{StaticResource Nav.IconButton}" Content="&#xE74D;" ToolTip="{x:Static loc:Strings.DeleteTip}" Command="{Binding DeleteCommand}" />
                            <Rectangle Width="1" Height="24" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Nav.Divider}" />
                            <Button Style="{StaticResource Nav.CommandButton}" Command="{Binding AddBookmarkCommand}" ToolTip="{x:Static loc:Strings.BookmarkFolderTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Nav.Glyph}" Text="&#xE734;" />
                                    <TextBlock Text="{x:Static loc:Strings.Bookmark}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Nav.CommandButton}" Command="{Binding SaveSessionCommand}" ToolTip="{x:Static loc:Strings.SaveSessionTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Nav.Glyph}" Text="&#xE74E;" />
                                    <TextBlock Text="{x:Static loc:Strings.SaveSession}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Rectangle Width="1" Height="24" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Nav.Divider}" />

                            <Button x:Name="ViewButton" Style="{StaticResource Nav.CommandButton}" Click="OnDropDownButtonClick" ToolTip="{x:Static loc:Strings.ViewOptionsTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Nav.Glyph}" Text="&#xE890;" />
                                    <TextBlock Text="{x:Static loc:Strings.View}" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Nav.IconFont}" FontSize="9" Margin="8,2,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="ViewDetailsItem" Header="{x:Static loc:Strings.ViewDetails}" InputGestureText="{x:Static loc:Strings.GestureViewDetails}"
                                                  Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:FileViewMode.Details}" />
                                        <MenuItem x:Name="ViewMediumItem" Header="{x:Static loc:Strings.ViewMediumIcons}" InputGestureText="{x:Static loc:Strings.GestureViewMedium}"
                                                  Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:FileViewMode.MediumIcons}" />
                                        <MenuItem x:Name="ViewLargeItem" Header="{x:Static loc:Strings.ViewLargeIcons}" InputGestureText="{x:Static loc:Strings.GestureViewLarge}"
                                                  Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:FileViewMode.LargeIcons}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static loc:Strings.HiddenItems}" IsCheckable="True" IsChecked="{Binding ShowHidden, Mode=TwoWay}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static loc:Strings.Panels}" IsEnabled="False" />
                                        <MenuItem Header="{x:Static loc:Strings.PanelBookmarks}" IsCheckable="True" IsChecked="{Binding Layout.Bookmarks.IsVisible, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.PanelSessions}" IsCheckable="True" IsChecked="{Binding Layout.Sessions.IsVisible, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.PanelFolders}" IsCheckable="True" IsChecked="{Binding Layout.FolderTree.IsVisible, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.PanelQuickView}" IsCheckable="True" IsChecked="{Binding Layout.QuickView.IsVisible, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.PanelFilters}" IsCheckable="True" IsChecked="{Binding Layout.Filters.IsVisible, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.PanelDropStack}" IsCheckable="True" IsChecked="{Binding Layout.DropStack.IsVisible, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.ResetPanels}" Command="{Binding Layout.ResetCommand}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static loc:Strings.ReopenTabs}" IsCheckable="True" IsChecked="{Binding RestoreLastSession, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.SyncFolderTree}" IsCheckable="True" IsChecked="{Binding SyncFolderTree, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.ShowDriveBar}" IsCheckable="True" IsChecked="{Binding ShowDriveBar, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.ShowGitStatus}" IsCheckable="True" IsChecked="{Binding ShowGitStatus, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.ShowFolderSizes}" IsCheckable="True" IsChecked="{Binding ShowFolderSizes, Mode=TwoWay}" />
                                        <MenuItem Header="{x:Static loc:Strings.RefreshTree}" Command="{Binding BuildTreeCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button x:Name="MoreButton" Style="{StaticResource Nav.IconButton}" Content="&#xE712;" ToolTip="{x:Static loc:Strings.MoreOptions}" Click="OnDropDownButtonClick">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static loc:Strings.SelectAll}" InputGestureText="{x:Static loc:Strings.GestureSelectAll}" Click="OnSelectAllClick" />
                                        <MenuItem Header="{x:Static loc:Strings.CopyPath}" InputGestureText="{x:Static loc:Strings.GestureCopyPath}" Command="{Binding CopyPathCommand}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static loc:Strings.OpenInNewTab}" Command="{Binding OpenInNewTabCommand}" />
                                        <MenuItem Header="{x:Static loc:Strings.OpenFileLocation}" Command="{Binding OpenContainingFolderCommand}" />
                                        <MenuItem Header="{x:Static loc:Strings.EditWithEditor}" InputGestureText="F4" Command="{Binding EditFileCommand}" />
                                        <MenuItem Header="{x:Static loc:Strings.AddToBookmarks}" Command="{Binding AddSelectionToBookmarksCommand}" />
                                        <MenuItem Header="{x:Static loc:Strings.AddToDropStack}" Command="{Binding AddSelectionToDropStackCommand}" />
                                        <MenuItem Header="{x:Static loc:Strings.DeletePermanently}" InputGestureText="{x:Static loc:Strings.GestureDeletePermanently}" Command="{Binding DeletePermanentlyCommand}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static loc:Strings.Properties}" InputGestureText="{x:Static loc:Strings.GestureProperties}" Command="{Binding PropertiesCommand}" />
                                        <Separator />
                                        <MenuItem x:Name="LanguageMenu" Header="{x:Static loc:Strings.Language}" SubmenuOpened="OnLanguageMenuOpened">
                                            <MenuItem Tag="" Header="{x:Static loc:Strings.LanguageSystem}" Click="OnLanguageClick" />
                                            <Separator />
                                            <MenuItem Tag="it" Header="Italiano" Click="OnLanguageClick" />
                                            <MenuItem Tag="en" Header="English" Click="OnLanguageClick" />
                                            <MenuItem Tag="de" Header="Deutsch" Click="OnLanguageClick" />
                                            <MenuItem Tag="fr" Header="Français" Click="OnLanguageClick" />
                                            <MenuItem Tag="es" Header="Español" Click="OnLanguageClick" />
                                        </MenuItem>
                                        <MenuItem Header="{x:Static loc:Strings.OpenDataFolder}" Click="OnOpenDataFolderClick" />
                                        <MenuItem Header="{x:Static loc:Strings.AboutTitle}" Click="OnAboutClick" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                    </WrapPanel>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Messaggio di errore, stile InfoBar -->
                    <Border Grid.Row="0" Margin="12,8,12,0" Padding="12,8" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource Nav.InfoBarBackground}" BorderBrush="{DynamicResource Nav.InfoBarBorder}"
                            Visibility="{Binding SelectedTab.ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                        <DockPanel>
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Nav.IconFont}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedTab.ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ListView Grid.Row="1" x:Name="FileList"
                              Visibility="{Binding SelectedTab.IsThisPc, Converter={StaticResource InverseBoolToVisibility}}"
                              ItemsSource="{Binding SelectedTab.Items}"
                              SelectedItem="{Binding SelectedTab.SelectedItem, Mode=TwoWay}"
                              SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource Nav.FileRow}"
                              Background="{DynamicResource Nav.Content}"
                              Foreground="{DynamicResource Nav.Text}"
                              BorderThickness="0" Padding="4,0"
                              AllowDrop="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              GridViewColumnHeader.Click="OnColumnHeaderClick"
                              SelectionChanged="OnFileSelectionChanged"
                              MouseDoubleClick="OnFileDoubleClick"
                              PreviewKeyDown="OnFileListKeyDown"
                              MouseRightButtonUp="OnFileListRightClick"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="Name"
                              PreviewMouseLeftButtonDown="OnFileListMouseDown"
                              PreviewMouseLeftButtonUp="OnFileListMouseUp"
                              PreviewMouseMove="OnFileListMouseMove"
                              DragOver="OnFileListDragOver"
                              Drop="OnFileListDrop">
                        <ListView.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                            <KeyBinding Gesture="Shift+Delete" Command="{Binding DeletePermanentlyCommand}" />
                            <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
                            <KeyBinding Key="F4" Command="{Binding EditFileCommand}" />
                            <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
                            <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
                            <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
                            <KeyBinding Gesture="Alt+Enter" Command="{Binding PropertiesCommand}" />
                        </ListView.InputBindings>
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource Nav.ColumnHeader}">
                                <GridViewColumn x:Name="NameColumn" Header="{x:Static loc:Strings.ColumnName}" Width="340">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Opacity="{Binding IsHidden, Converter={StaticResource HiddenToOpacity}}">
                                                <Grid Width="16" Height="16" Margin="2,0,10,0">
                                                    <Image Source="{Binding Converter={StaticResource Icon}}" />
                                                    <ctl:GitBadge Width="10" Height="10" Margin="-2,0,0,-2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                  Status="{Binding GitStatus}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FullPath}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ModifiedColumn" Header="{x:Static loc:Strings.ColumnModified}" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource Nav.TextSecondary}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="TypeColumn" Header="{x:Static loc:Strings.ColumnType}" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource Nav.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="SizeColumn" Header="{x:Static loc:Strings.ColumnSize}" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Nav.TextSecondary}" HorizontalAlignment="Right" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static loc:Strings.ColumnLocation}" Width="0" x:Name="LocationColumn">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Location}" Foreground="{DynamicResource Nav.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Questo PC: le unità al posto della lista dei file -->
                    <ScrollViewer Grid.Row="1" x:Name="ThisPcView" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SelectedTab.IsThisPc, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="20,4,12,16">
                            <TextBlock Text="{x:Static loc:Strings.DevicesAndDrives}" Style="{StaticResource Nav.DriveGroupHeader}" />
                            <ListBox x:Name="DriveList" ItemsSource="{Binding SelectedTab.Drives}" Style="{StaticResource Nav.DriveList}" />

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab.NetworkDrives.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{x:Static loc:Strings.NetworkLocations}" Style="{StaticResource Nav.DriveGroupHeader}" />
                                <ListBox x:Name="NetworkDriveList" ItemsSource="{Binding SelectedTab.NetworkDrives}" Style="{StaticResource Nav.DriveList}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Cartella vuota / nessun risultato -->
                    <TextBlock Grid.Row="1" Margin="0,64,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Foreground="{DynamicResource Nav.TextSecondary}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Text" Value="{x:Static loc:Strings.EmptyFolder}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedTab.Items.Count}" Value="0" />
                                            <Condition Binding="{Binding SelectedTab.IsLoading}" Value="False" />
                                            <Condition Binding="{Binding SelectedTab.ErrorMessage}" Value="{x:Null}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.IsFiltered}" Value="True">
                                        <Setter Property="Text" Value="{x:Static loc:Strings.NoFilterMatch}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.IsSearchResults}" Value="True">
                                        <Setter Property="Text" Value="{x:Static loc:Strings.NoSearchMatch}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.IsThisPc}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ProgressBar Grid.Row="1" Height="2" VerticalAlignment="Top" IsIndeterminate="True" Margin="0" MinHeight="2"
                                 Foreground="{DynamicResource Nav.Accent}" Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding SelectedTab.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                </DockPanel>

                    <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Visibility="Collapsed" />
                    <Rectangle x:Name="BottomDivider" Grid.Row="1" Height="1" VerticalAlignment="Center" Fill="{DynamicResource Nav.Divider}"
                               IsHitTestVisible="False" Visibility="Collapsed" />

                    <!-- Zona inferiore: i pannelli stanno affiancati, come la Quickview di CubicExplorer -->
                    <Grid x:Name="BottomDock" Grid.Row="2" Tag="Bottom" Background="{DynamicResource Nav.Content}" AllowDrop="True"
                          PreviewDragOver="OnDockPreviewDragOver" PreviewDragLeave="OnDockPreviewDragLeave" PreviewDrop="OnDockPreviewDrop" />
                </Grid>

                <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
                <Rectangle x:Name="RightDivider" Grid.Column="3" Width="1" HorizontalAlignment="Center" Fill="{DynamicResource Nav.Divider}" IsHitTestVisible="False" />

                <Grid x:Name="RightDock" Grid.Column="4" Tag="Right" Background="{DynamicResource Nav.Content}" AllowDrop="True"
                      PreviewDragOver="OnDockPreviewDragOver" PreviewDragLeave="OnDockPreviewDragLeave" PreviewDrop="OnDockPreviewDrop" />
            </Grid>

            <!-- ===================== Pannelli ===================== -->
            <!-- Deposito dei pannelli: quelli visibili vengono spostati nei due lati, quelli nascosti restano qui. -->
            <Grid x:Name="PanelStore" Grid.Row="1" Visibility="Collapsed">

            <!-- Segnalibri: cartelle e file; si riordinano trascinandoli e si aggiungono trascinando file o cartelle -->
            <DockPanel x:Name="BookmarksPanel" Tag="Bookmarks">
                <DockPanel DockPanel.Dock="Top" Height="36" Tag="Bookmarks" Background="Transparent" ToolTip="{x:Static loc:Strings.DragToMovePanel}"
                           PreviewMouseLeftButtonDown="OnPanelHeaderMouseDown" PreviewMouseMove="OnPanelHeaderMouseMove"
                           MouseRightButtonUp="OnPanelHeaderRightClick">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE8A7;"
                                ToolTip="{x:Static loc:Strings.OpenAllBookmarksTip}" Command="{Binding OpenAllBookmarksCommand}" />
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE8F4;"
                                ToolTip="{x:Static loc:Strings.NewBookmarkFolderTip}" Command="{Binding NewBookmarkFolderCommand}" />
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE710;"
                                ToolTip="{x:Static loc:Strings.AddCurrentFolderTip}" Command="{Binding AddBookmarkCommand}" />
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE712;"
                                Tag="Bookmarks" ToolTip="{x:Static loc:Strings.PanelOptions}" Click="OnPanelMenuClick" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Nav.SectionHeader}" Text="{x:Static loc:Strings.PanelBookmarks}" />
                </DockPanel>
                <Grid>
                    <TreeView x:Name="BookmarkTree" ItemsSource="{Binding Bookmarks}" AllowDrop="True" ctl:CompactRows.IsCompact="True"
                              Background="Transparent" BorderThickness="0" Padding="6,4,6,8"
                              Foreground="{DynamicResource Nav.Text}"
                              SelectedItemChanged="OnBookmarkSelectionChanged"
                              MouseDoubleClick="OnBookmarkDoubleClick" PreviewMouseDown="OnBookmarkMouseDown" PreviewMouseMove="OnBookmarkMouseMove"
                              MouseRightButtonUp="OnBookmarkRightClick"
                              DragOver="OnBookmarkDragOver" DragLeave="OnBookmarkDragLeave" Drop="OnBookmarkDrop">
                        <TreeView.InputBindings>
                            <KeyBinding Key="F2" Command="{Binding RenameBookmarkCommand}" />
                            <KeyBinding Key="Delete" Command="{Binding RemoveBookmarkCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding OpenBookmarkCommand}" />
                        </TreeView.InputBindings>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{DynamicResource Nav.Text}" />
                                <Style.Triggers>
                                    <!-- Righe compatte da ~23 px, sempre (il tema Fluent usa Padding 4 e Margin 0,0,0,2 applicato due volte) -->
                                    <Trigger Property="ctl:CompactRows.IsCompact" Value="True">
                                        <Setter Property="Padding" Value="4,0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:BookmarkItemViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2" ToolTip="{Binding Path}"
                                            Opacity="{Binding Path, Converter={StaticResource PathExistsToOpacity}}">
                                    <!-- Cartella virtuale: glifo nel colore d'accento; segnalibro: icona reale del file o della cartella -->
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Nav.IconFont}" FontSize="15" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Nav.Accent}" VerticalAlignment="Center"
                                               Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}" />
                                    <Image Width="16" Height="16" Margin="0,0,8,0" Source="{Binding Path, Converter={StaticResource Icon}}"
                                           Visibility="{Binding IsFolder, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <TextBlock Margin="12,2,12,8" TextWrapping="Wrap" IsHitTestVisible="False" Foreground="{DynamicResource Nav.TextSecondary}"
                               Text="{x:Static loc:Strings.NoBookmarks}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Bookmarks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <!-- Sessioni -->
            <DockPanel x:Name="SessionsPanel" Tag="Sessions">
                <DockPanel DockPanel.Dock="Top" Height="36" Tag="Sessions" Background="Transparent" ToolTip="{x:Static loc:Strings.DragToMovePanel}"
                           PreviewMouseLeftButtonDown="OnPanelHeaderMouseDown" PreviewMouseMove="OnPanelHeaderMouseMove"
                           MouseRightButtonUp="OnPanelHeaderRightClick">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74E;"
                                ToolTip="{x:Static loc:Strings.SaveSessionTip}" Command="{Binding SaveSessionCommand}" />
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE712;"
                                Tag="Sessions" ToolTip="{x:Static loc:Strings.PanelOptions}" Click="OnPanelMenuClick" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Nav.SectionHeader}" Text="{x:Static loc:Strings.PanelSessions}" />
                </DockPanel>
                <Grid>
                    <ListBox Style="{StaticResource Nav.PaneList}"
                             ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                             MouseDoubleClick="OnSessionDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="&#xE8A1;" FontFamily="{StaticResource Nav.IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Nav.TextSecondary}" Margin="8,0,0,0"
                                               Text="{Binding TabPaths.Count, StringFormat={x:Static loc:Strings.SessionTabs}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static loc:Strings.RestoreSession}" Command="{Binding LoadSessionCommand}" />
                                <MenuItem Header="{x:Static loc:Strings.Delete}" Command="{Binding DeleteSessionCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Margin="12,2,12,8" TextWrapping="Wrap" IsHitTestVisible="False" Foreground="{DynamicResource Nav.TextSecondary}"
                               Text="{x:Static loc:Strings.NoSessions}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <!-- Albero cartelle -->
            <DockPanel x:Name="FolderTreePanel" Tag="FolderTree">
                <DockPanel DockPanel.Dock="Top" Height="36" Tag="FolderTree" Background="Transparent" ToolTip="{x:Static loc:Strings.DragToMovePanel}"
                           PreviewMouseLeftButtonDown="OnPanelHeaderMouseDown" PreviewMouseMove="OnPanelHeaderMouseMove"
                           MouseRightButtonUp="OnPanelHeaderRightClick">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE72C;"
                                ToolTip="{x:Static loc:Strings.RefreshTreeTip}" Command="{Binding BuildTreeCommand}" />
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE712;"
                                Tag="FolderTree" ToolTip="{x:Static loc:Strings.PanelOptions}" Click="OnPanelMenuClick" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Nav.SectionHeader}" Text="{x:Static loc:Strings.PanelFolders}" />
                </DockPanel>
                <!-- Barra delle unità, come in CubicExplorer: clic = apri, Ctrl+clic o clic centrale = nuova scheda, clic destro = menu di Windows -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Nav.Divider}" BorderThickness="0,0,0,1" Margin="6,0,6,2" Padding="0,0,0,3"
                        Visibility="{Binding ShowDriveBar, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding DriveButtons}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveButtonViewModel}">
                                <Button Style="{StaticResource Nav.DriveButton}" ToolTip="{Binding ToolTip}"
                                        Click="OnDriveButtonClick" MouseUp="OnDriveButtonMouseUp" MouseRightButtonUp="OnDriveButtonRightClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Margin="0,0,4,0" Source="{Binding Drive, Converter={StaticResource Icon}}" />
                                        <TextBlock Text="{Binding Letter}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TreeView x:Name="FolderTree" ItemsSource="{Binding TreeRoots}" ctl:CompactRows.IsCompact="True"
                          Background="Transparent" BorderThickness="0" Padding="6,4,6,8"
                          Foreground="{DynamicResource Nav.Text}"
                          SelectedItemChanged="OnTreeSelectionChanged"
                          PreviewMouseLeftButtonDown="OnTreeMouseDown" PreviewMouseMove="OnTreeMouseMove">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="{DynamicResource Nav.Text}" />
                            <Style.Triggers>
                                <Trigger Property="ctl:CompactRows.IsCompact" Value="True">
                                    <Setter Property="Padding" Value="4,0" />
                                    <Setter Property="Margin" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Image Width="16" Height="16" Margin="0,0,8,0" Source="{Binding Converter={StaticResource Icon}}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsGroup}" Value="True" />
                                                        <Condition Binding="{Binding FullPath}" Value="" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <!-- Quick View -->
            <DockPanel x:Name="QuickViewPanel" Tag="QuickView">
                <DockPanel DockPanel.Dock="Top" Height="36" Tag="QuickView" Background="Transparent" ToolTip="{x:Static loc:Strings.DragToMovePanel}"
                           PreviewMouseLeftButtonDown="OnPanelHeaderMouseDown" PreviewMouseMove="OnPanelHeaderMouseMove"
                           MouseRightButtonUp="OnPanelHeaderRightClick">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE712;"
                                Tag="QuickView" ToolTip="{x:Static loc:Strings.PanelOptions}" Click="OnPanelMenuClick" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Nav.SectionHeader}" Text="{x:Static loc:Strings.PanelQuickView}" />
                </DockPanel>
                    <Grid Margin="16,0,12,12" DataContext="{Binding QuickView}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Image DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top"
                                   Source="{Binding FilePath, Converter={StaticResource Icon}, ConverterParameter=large}" />
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Margin="0,8,0,12" Text="{Binding Details}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Nav.TextSecondary}" />

                        <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.SelectFileForPreview}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Nav.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=None}" />

                        <Image Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding FilePath, Converter={StaticResource ImagePath}}"
                               Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Image}" />

                        <!-- Testo: si modifica direttamente qui e si salva con Ctrl+S, mantenendo la codifica del file -->
                        <DockPanel Grid.Row="2" Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Text}">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="26" FontSize="13" Content="&#xE74E;"
                                            ToolTip="{x:Static loc:Strings.SaveTip}" Command="{Binding SaveChangesCommand}" />
                                    <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="26" FontSize="13" Content="&#xE7A7;"
                                            ToolTip="{x:Static loc:Strings.RevertChangesTip}" Command="{Binding RevertCommand}" />
                                    <ToggleButton x:Name="QuickViewWrap" Style="{StaticResource Nav.IconButton}" Width="28" Height="26" FontSize="13"
                                                  Content="&#xE751;" ToolTip="{x:Static loc:Strings.WordWrapTip}" />
                                    <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="26" FontSize="13" Content="&#xE8A7;"
                                            ToolTip="{x:Static loc:Strings.OpenInEditorTip}" Click="OnQuickViewOpenInEditor" />
                                </StackPanel>
                                <TextBlock Text="{Binding TextStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding TextStatus}" Foreground="{DynamicResource Nav.TextSecondary}" FontSize="11" />
                            </DockPanel>
                            <Border CornerRadius="4" Background="{DynamicResource Nav.CodeBackground}"
                                    BorderBrush="{DynamicResource Nav.Divider}" BorderThickness="1" Padding="2">
                                <avalon:TextEditor x:Name="QuickViewEditor"
                                                   FontFamily="{StaticResource Nav.MonoFont}" FontSize="11.5"
                                                   ShowLineNumbers="True" Padding="4"
                                                   Background="Transparent"
                                                   Foreground="{DynamicResource Nav.Text}"
                                                   LineNumbersForeground="{DynamicResource Nav.TextSecondary}"
                                                   WordWrap="{Binding IsChecked, ElementName=QuickViewWrap}"
                                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <avalon:TextEditor.InputBindings>
                                        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveChangesCommand}" />
                                    </avalon:TextEditor.InputBindings>
                                </avalon:TextEditor>
                            </Border>
                        </DockPanel>

                        <Grid Grid.Row="2" Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Media}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- La sorgente viene impostata dal code-behind solo per i file audio/video -->
                            <MediaElement x:Name="MediaPreview" MaxHeight="300" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Style="{StaticResource Nav.IconButton}" Content="&#xE768;" ToolTip="{x:Static loc:Strings.Play}" Click="OnMediaPlay" />
                                <Button Style="{StaticResource Nav.IconButton}" Content="&#xE769;" ToolTip="{x:Static loc:Strings.Pause}" Click="OnMediaPause" />
                                <Button Style="{StaticResource Nav.IconButton}" Content="&#xE71A;" ToolTip="{x:Static loc:Strings.Stop}" Click="OnMediaStop" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.NoPreview}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Nav.TextSecondary}" VerticalAlignment="Top"
                                   Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Info}" />
                    </Grid>
            </DockPanel>

            <!-- Filtri -->
            <DockPanel x:Name="FiltersPanel" Tag="Filters">
                <DockPanel DockPanel.Dock="Top" Height="36" Tag="Filters" Background="Transparent" ToolTip="{x:Static loc:Strings.DragToMovePanel}"
                           PreviewMouseLeftButtonDown="OnPanelHeaderMouseDown" PreviewMouseMove="OnPanelHeaderMouseMove"
                           MouseRightButtonUp="OnPanelHeaderRightClick">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE894;"
                                ToolTip="{x:Static loc:Strings.ClearFiltersTip}" Command="{Binding SelectedTab.ClearFilterCommand}" />
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE712;"
                                Tag="Filters" ToolTip="{x:Static loc:Strings.PanelOptions}" Click="OnPanelMenuClick" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Nav.SectionHeader}" Text="{x:Static loc:Strings.PanelFilters}" />
                </DockPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Nav.InputBox}" Margin="12,0">
                        <Grid>
                            <TextBox x:Name="FilterBox" Style="{StaticResource Nav.Input}" Margin="10,0"
                                     Text="{Binding SelectedTab.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                            <TextBlock Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Nav.TextSecondary}" Text="{x:Static loc:Strings.FilterPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <CheckBox Grid.Row="1" Margin="12,8,12,4" Content="{x:Static loc:Strings.StrictFilter}"
                              Foreground="{DynamicResource Nav.Text}"
                              IsChecked="{Binding SelectedTab.StrictFilter, Mode=TwoWay}" />
                    <DockPanel Grid.Row="2" Margin="12,4,8,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Nav.CommandButton}" Height="26" Content="{x:Static loc:Strings.All}" Command="{Binding SelectedTab.CheckAllExtensionsCommand}" />
                            <Button Style="{StaticResource Nav.CommandButton}" Height="26" Content="{x:Static loc:Strings.None}" Command="{Binding SelectedTab.UncheckAllExtensionsCommand}" />
                        </StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.FileTypes}" Foreground="{DynamicResource Nav.TextSecondary}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="3" Margin="12,4,12,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedTab.ExtensionFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Foreground="{DynamicResource Nav.Text}" Margin="0,1" MinHeight="0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- Drop Stack -->
            <DockPanel x:Name="DropStackPanel" Tag="DropStack">
                <DockPanel DockPanel.Dock="Top" Height="36" Tag="DropStack" Background="Transparent" ToolTip="{x:Static loc:Strings.DragToMovePanel}"
                           PreviewMouseLeftButtonDown="OnPanelHeaderMouseDown" PreviewMouseMove="OnPanelHeaderMouseMove"
                           MouseRightButtonUp="OnPanelHeaderRightClick">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE8C8;"
                                ToolTip="{x:Static loc:Strings.DropStackCopyTip}" Command="{Binding DropStackCopyHereCommand}" />
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE8DE;"
                                ToolTip="{x:Static loc:Strings.DropStackMoveTip}" Command="{Binding DropStackMoveHereCommand}" />
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;"
                                ToolTip="{x:Static loc:Strings.DropStackClearTip}" Command="{Binding ClearDropStackCommand}" />
                        <Button Style="{StaticResource Nav.IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE712;"
                                Tag="DropStack" ToolTip="{x:Static loc:Strings.PanelOptions}" Click="OnPanelMenuClick" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Nav.SectionHeader}" Text="{x:Static loc:Strings.PanelDropStack}" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="DropStackList" Style="{StaticResource Nav.PaneList}"
                             ItemsSource="{Binding DropStack}" AllowDrop="True" SelectionMode="Extended"
                             DragOver="OnDropStackDragOver" Drop="OnDropStackDrop"
                             PreviewMouseLeftButtonDown="OnDropStackMouseDown" PreviewMouseMove="OnDropStackMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                    <Image Width="16" Height="16" Margin="0,0,8,0" Source="{Binding Converter={StaticResource Icon}}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static loc:Strings.DropStackRemove}" Click="OnDropStackRemoveClick" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Margin="12,2,12,8" TextWrapping="Wrap" IsHitTestVisible="False" Foreground="{DynamicResource Nav.TextSecondary}"
                               Text="{x:Static loc:Strings.DropStackEmpty}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DropStack.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
            </Grid>


            <!-- ===================== Riga 2: barra di stato ===================== -->
            <DockPanel Grid.Row="2" Background="{DynamicResource Nav.Content}">
                <TextBlock DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Nav.TextSecondary}"
                           Text="{Binding FreeSpaceText}" />
                <TextBlock DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Nav.TextSecondary}"
                           Text="{x:Static loc:Strings.Portable}" Visibility="{Binding IsPortable, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="16,0" VerticalAlignment="Center" Foreground="{DynamicResource Nav.TextSecondary}"
                           Text="{Binding SelectedTab.StatusText}" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
