<Window x:Class="Navigator.App.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Navigator.Core.Localization;assembly=Navigator.Core"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Width="900" Height="650" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Nav.Toolbar}"
        Foreground="{DynamicResource Nav.Text}"
        FontFamily="{StaticResource Nav.UiFont}"
        Icon="/Assets/Navigator.ico"
        FontSize="12">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="ApplicationCommands.Save" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSaveExecuted" />
    </Window.CommandBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="44" BorderBrush="{DynamicResource Nav.Divider}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0"
                           Foreground="{DynamicResource Nav.TextSecondary}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Nav.CommandButton}" Command="ApplicationCommands.Save" ToolTip="{x:Static loc:Strings.SaveTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Nav.Glyph}" Text="&#xE74E;" />
                            <TextBlock Text="{x:Static loc:Strings.Save}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="WrapToggle" Style="{StaticResource Nav.CommandButton}" ToolTip="{x:Static loc:Strings.WordWrapTip}"
                                  Checked="OnWrapChanged" Unchecked="OnWrapChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Nav.Glyph}" Text="&#xE751;" />
                            <TextBlock Text="{x:Static loc:Strings.WordWrap}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </DockPanel>
        </Border>
        <avalon:TextEditor x:Name="Editor"
                           FontFamily="{StaticResource Nav.MonoFont}" FontSize="13"
                           ShowLineNumbers="True"
                           Background="{DynamicResource Nav.Content}"
                           Foreground="{DynamicResource Nav.Text}"
                           LineNumbersForeground="{DynamicResource Nav.TextSecondary}"
                           Padding="4"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
